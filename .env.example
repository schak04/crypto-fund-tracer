# Environment: development, test, or production.
CFT_ENV=development

# HTTP listen address/port for the REST API.
CFT_HTTP_ADDR=:8080

# PostgreSQL connection string for persistence.
CFT_DB_URL=postgres://cft:cft@localhost:5432/cft?sslmode=disable

# Base URL of the blockchain-analysis component. The backend calls POST /analysis.
CFT_ANALYSIS_URL=http://localhost:9090

# Default maximum fund-trace depth sent with analysis requests. Must be between 1 and 5.
CFT_ANALYSIS_MAX_DEPTH=3
