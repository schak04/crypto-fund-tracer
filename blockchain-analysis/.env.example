# ---------------------------------------------------------------------------
# Blockchain Analysis service configuration (copy to .env and edit).
# Every variable is optional; the defaults below are what the code uses.
# ---------------------------------------------------------------------------

# Which data source to use:
#   mock       -> reads app/data/demo_scenario.json (no API key, no network).
#   etherscan  -> calls the Etherscan API V2 (needs ETHERSCAN_API_KEY).
PROVIDER=mock

# --- Etherscan provider ----------------------------------------------------
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_CHAIN_ID=1
# Seconds to wait for one HTTP call to Etherscan.
HTTP_TIMEOUT_SECONDS=10
# Minimum gap between two Etherscan calls (client-side rate limiter).
MIN_REQUEST_INTERVAL_SECONDS=0.25
# Retries when Etherscan answers "rate limit reached".
MAX_RETRIES=2
# Public explorer used to build `raw_reference` links.
EXPLORER_TX_URL=https://etherscan.io/tx/

# --- Tracing behaviour -----------------------------------------------------
# Hard time budget for ONE analysis. The Go backend times out at 30s, so we
# stop at 25s and return a clean error instead of a dead connection.
BUDGET_SECONDS=25
# Only the N largest outgoing transfers of each address are followed.
MAX_TRANSFERS_PER_ADDRESS=10
# Max number of addresses we fetch history for (each costs ~2 API calls).
MAX_EXPANSIONS=40
# Transfers below this amount (in ETH) are treated as dust and ignored.
MIN_VALUE_ETH=0.001
# How many provider calls may run at the same time.
CONCURRENCY=3
# Only follow transfers that happen AFTER funds arrived at an address.
ENFORCE_TEMPORAL_ORDER=true
# Look up whether end-of-trace addresses are smart contracts (role "other").
CHECK_CONTRACTS=true
MAX_CONTRACT_CHECKS=20

# --- Data files --------------------------------------------------------------
VASP_FILE=app/data/vasp_addresses.json
MOCK_SCENARIO_FILE=app/data/demo_scenario.json

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=9090
LOG_LEVEL=INFO
